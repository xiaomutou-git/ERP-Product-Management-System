# 后端环境变量示例文件（安全修复 VULN-04）
# ------------------------------------------------------------------
# 首次部署时复制本文件为 .env 并填写真实值；.env 已被 .gitignore 排除，
# 严禁将真实密钥提交到版本库或写入文档。

# 服务端口（默认 3001）
PORT=3001

# JWT 签名密钥（必填，长度 >= 32 字符；请使用高熵随机值，勿用可预测字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=请替换为高熵随机密钥

# access token 有效期（秒）：默认 2 小时
ACCESS_TOKEN_TTL=7200

# refresh token 有效期（秒）：默认 7 天
REFRESH_TOKEN_TTL=604800

# refresh 轮换宽限窗口（秒）：多 tab 并发刷新时旧令牌复用的容忍期，默认 30
# 设为 0 关闭宽限（回到严格重放模式）；每次宽限复用均写审计日志 refresh_grace_reuse
# REFRESH_GRACE_PERIOD_SECONDS=30

# 数据库文件路径（相对 backend 运行目录）
DB_PATH=./data/erp.db

# 允许的前端来源（CORS），生产环境禁止使用 *
# 同时用作 CSRF 防护的 Origin 白名单（写操作校验，多个来源用英文逗号分隔）
CORS_ORIGIN=http://localhost:5173

# 运行环境：production 时启用 CSP、Cookie Secure 并托管 frontend/dist（可选）
# NODE_ENV=production
